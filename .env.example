# Public / non-secret
PUBLIC_SITE_NAME="Fonti del Palio"
PUBLIC_SITE_URL="https://www.fontidelpalio.org"
PUBLIC_TURNSTILE_SITE_KEY=""
PUBLIC_LAST_VERIFIED="2026-07-26"

# OpenAI — server-side only. Nessuna chiave nel browser o nel repository.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Decisione 9 (26/07/2026): nessun fallback automatico durante la prima beta.
# gpt-5.6-luna resta configurabile ma NON viene chiamato automaticamente.
# Qualsiasi modello di escalation va scelto solo dopo aver valutato l'intero
# set di 50 domande di test su accuratezza, latenza e costo.
OPENAI_FALLBACK_MODEL=""
OPENAI_FALLBACK_ENABLED="false"

OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS="512"

# Decisione 1 (26/07/2026): reasoning.effort esplicito, mai lasciato al default
# "medium" del modello — gpt-5-mini supporta minimal/low/medium/high.
# "low" è il default sicuro; "minimal" solo se confermato compatibile con
# l'SDK installato e con eventuale tool-calling nella stessa richiesta.
OPENAI_REASONING_EFFORT="low"

# Budget massimo di output. 900 causava risposte vuote/incomplete perché
# i token di reasoning nascosti condividono lo stesso budget. Intervallo
# previsto: 2500-4000.
OPENAI_MAX_OUTPUT_TOKENS="3000"

# Cloudflare Turnstile — server-side secret
TURNSTILE_SECRET_KEY=""

# Decisione 5 (26/07/2026): allowlist multi-hostname, non un solo hostname
# hardcoded, per supportare i Deploy Preview di Netlify oltre alla produzione.
# Elenco separato da virgole, validato server-side insieme ad azione e
# monouso del token.
TURNSTILE_ALLOWED_HOSTNAMES="fontidelpalio.org,www.fontidelpalio.org"
TURNSTILE_EXPECTED_ACTION="ask"

# Upstash Redis — server-side only. Decisione 8: SOLO contatori di
# rate-limit in v1, nessuna cache di risposte/domande.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Rate limiting — applicato tramite una singola operazione atomica
# (Lua script o equivalente) su tutte le dimensioni insieme, per evitare
# che una richiesta respinta consumi parzialmente contatori non correlati.
RATE_LIMIT_HMAC_SECRET=""
RATE_LIMIT_BROWSER_DAILY="5"
RATE_LIMIT_IP_DAILY="15"
RATE_LIMIT_IP_MINUTE="3"
RATE_LIMIT_GLOBAL_DAILY="300"

# AI controls
# Default "false": il sito documentale statico deve funzionare integralmente
# senza AI. Non impostare "true" in locale, in Deploy Preview o in produzione
# prima dell'approvazione esplicita di M6 (vedi data/static-site-milestone-plan.md).
AI_ENABLED="false"
AI_DAILY_GLOBAL_LIMIT="300"

# Decisione 4 (26/07/2026): timeout applicativo totale per la funzione /ask.
# Deve restituire un 503 controllato tramite AbortController prima che
# Netlify interrompa la funzione. Verificare il timeout sincrono reale e i
# limiti del piano Netlify collegato prima del lancio in produzione.
ASK_TIMEOUT_MS="8000"

# Environment
NODE_ENV="development"
