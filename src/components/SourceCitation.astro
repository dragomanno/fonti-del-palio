---
/**
 * Citazione canonica visibile di un chunk.
 *
 * Ogni frammento di testo mostrato sul sito dichiara da dove viene: file
 * canonico, intervallo di righe e hash del contenuto. È l'impegno editoriale
 * centrale del progetto — prima gli atti, poi le risposte — e non va reso
 * opzionale né nascosto dietro un'interazione.
 */
import type { Citation } from "../lib/corpus";

export interface Props {
  citation: Citation;
  headingPath?: string[];
}

const { citation, headingPath = [] } = Astro.props;
const shortHash = citation.contentHash.replace(/^sha256:/, "").slice(0, 12);
---

<div class="citation" data-pagefind-ignore>
  <span class="citation__label">Fonte canonica</span>
  <p class="citation__ref">
    <span class="citation__file">{citation.fileLabel}</span>
    <span class="citation__sep">·</span>
    <span class="citation__lines">
      righe {citation.startLine}–{citation.endLine}
    </span>
  </p>
  {
    headingPath.length > 0 && (
      <p class="citation__path">{headingPath.join(" › ")}</p>
    )
  }
  <p class="citation__meta">
    <code>{citation.fileName}</code>
    <span class="citation__sep">·</span>
    <span title={citation.contentHash}>hash {shortHash}…</span>
  </p>
</div>

<style>
  .citation {
    margin-top: var(--space-2);
    padding: 0.625rem 0.75rem;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-sm);
  }
  .citation__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-green);
    margin-bottom: 0.25rem;
  }
  .citation__ref {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text);
  }
  .citation__file {
    font-weight: 600;
  }
  .citation__path {
    margin: 0.25rem 0 0;
    font-size: var(--text-caption);
    color: var(--color-text-muted);
  }
  .citation__meta {
    margin: 0.375rem 0 0;
    font-size: 0.75rem;
    color: var(--color-text-faint);
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }
  .citation__meta code {
    font-size: 0.75rem;
    background: none;
    padding: 0;
    color: inherit;
  }
  .citation__sep {
    margin: 0 0.375rem;
    color: var(--color-text-faint);
  }
</style>
