---
/**
 * Rende le QUATTRO dimensioni di stato come indicatori separati.
 *
 * Vincolo editoriale non negoziabile (piano milestone M1, §18 del brief):
 * non esiste e non deve esistere un'unica etichetta sintetica del tipo
 * "vigente / non riprodotto / superato". Le dimensioni sono indipendenti e
 * vengono sempre mostrate distinte, con il letterale della fonte quando c'è.
 * La mancata riproduzione in un atto successivo NON implica abrogazione.
 */
import type { ChunkStatus } from "../lib/corpus";
import { DIMENSION_LABELS, displayStatus, publicExplanation } from "../lib/corpus";

export interface Props {
  status: ChunkStatus;
  compact?: boolean;
}

const { status, compact = false } = Astro.props;

const order = [
  "documentaryStatus",
  "legalStatus",
  "presenceStatus",
  "researchStatus",
] as const;

const dims = order
  .map((key) => ({ key, dim: status[key], display: displayStatus(status[key] ?? null) }))
  .filter((d) => d.dim !== null);

// Una dimensione con un letterale documentato NON è un'assenza: il registro
// riporta un testo, semplicemente non ancora ricondotto a una voce di
// legenda. Solo l'assenza dichiarata conta come tale.
const allAbsent = dims.length > 0 && dims.every((d) => !d.display?.documented);

// Quando nessuna delle quattro dimensioni è documentata, ripetere quattro volte
// la stessa motivazione è rumore. La spiegazione — che proviene dal corpus, non
// da noi — viene mostrata una sola volta sotto la griglia, nella formulazione
// pubblica: la terminologia interna di pipeline non compare in pagina.
const sharedExplanation = allAbsent
  ? [...new Set(dims.map((d) => publicExplanation(d.dim!.explanation)).filter(Boolean))]
  : [];
---

<dl class:list={["status-grid", compact && "status-grid--compact"]}>
  {
    dims.map(({ key, dim, display }) => {
      const d = dim!;
      const shown = display!;
      // Il letterale viene ripetuto sotto la riga principale solo quando NON è
      // già il valore mostrato, per non stampare due volte la stessa stringa.
      const literal = d.literal ?? d.source?.literal ?? null;
      const repeatLiteral = literal !== null && shown.kind !== "literal";
      return (
        <div class:list={["status-cell", shown.documented ? "is-documented" : "is-null"]}>
          <dt>{DIMENSION_LABELS[key] ?? key}</dt>
          <dd>
            {shown.kind === "reason" ? (
              <span class="status-absent">{shown.text}</span>
            ) : (
              <span class:list={["status-value", shown.kind === "literal" && "status-value--literal"]}>
                {shown.text}
              </span>
            )}
            {shown.kind === "literal" && shown.sourceField && (
              <span class="status-literal">
                Testo letterale del campo «{shown.sourceField}» del registro, non ancora
                ricondotto a una voce di legenda.
              </span>
            )}
            {repeatLiteral && (
              <span class="status-literal">
                Testo della fonte: <q>{literal}</q>
              </span>
            )}
            {d.inheritedFrom?.provisional && (
              <span class="status-provisional">
                Attribuzione provvisoria — da verificare sull'originale
              </span>
            )}
          </dd>
        </div>
      );
    })
  }
</dl>
{
  sharedExplanation.length > 0 && (
    <p class="status-note">
      {sharedExplanation.join(" ")}
    </p>
  )
}

<style>
  .status-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    padding: 0;
  }
  .status-cell {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-text-faint);
    padding: 0.625rem 0.75rem;
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }
  .status-cell.is-documented {
    border-left-color: var(--color-green);
  }
  .status-cell dt {
    font-family: var(--font-mono);
    /* 12px: sotto questa soglia i metadati diventano illeggibili su mobile. */
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin: 0 0 0.25rem;
  }
  .status-cell dd {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .status-value {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
  }
  /* Il letterale del registro è documentato quanto un valore normalizzato, ma
     non è una voce di legenda: peso tipografico più leggero per non farlo
     leggere come un valore consolidato. */
  .status-value--literal {
    font-weight: 500;
  }
  .status-absent {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    font-style: italic;
  }
  .status-literal {
    font-size: var(--text-caption);
    color: var(--color-text-muted);
    line-height: 1.45;
  }
  .status-literal q {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-style: normal;
  }
  .status-provisional {
    font-size: var(--text-caption);
    color: var(--color-warning);
    font-weight: 500;
  }
  .status-grid--compact .status-cell {
    padding: 0.5rem 0.625rem;
  }
  .status-note {
    margin: 0.5rem 0 0;
    font-size: var(--text-caption);
    line-height: 1.5;
    color: var(--color-text-muted);
    max-width: var(--measure);
  }
</style>
