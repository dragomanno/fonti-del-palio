---
import "@fontsource/fraunces/500.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import { SITE_NAME, SITE_URL, PISTAKKIO_URL, PISTAKKIO_LABEL, GITHUB_URL, GITHUB_LABEL } from "../config/site";

export interface Props {
  title: string;
  description?: string;
  activePath?: string;
  /** Se false, esclude la pagina sia dall'indicizzazione dei motori di ricerca
   *  esterni (meta robots noindex) sia dall'indice di ricerca interno Pagefind
   *  (marcatore data-pagefind-ignore="all" nel head). Usato per i documenti di
   *  pianificazione interna, che non sono fonti documentali del Palio.
   *  Pagefind e' integrato: l'indice viene costruito su `dist/` al termine di
   *  `npm run build` e l'esclusione e' quindi effettiva. Default true. */
  indexable?: boolean;
  /** Se false, il contenuto della pagina non viene usato come corpo indicizzato
   *  da Pagefind (utile per pagine di servizio come /ricerca). Default true. */
  searchable?: boolean;
}
const {
  title,
  description = "Fonti del Palio — corpus documentale del Protocollo Equino del Palio di Siena.",
  activePath = "",
  indexable = true,
  searchable = true,
} = Astro.props;
const siteName = SITE_NAME;

// v0.1.0 — IDENTITA' DEL DOCUMENTO E STATO DI NAVIGAZIONE SONO VALORI DISTINTI.
//
// Prima di questa correzione il canonical era derivato da `activePath`, che e'
// una proprieta' di NAVIGAZIONE: serve a evidenziare la voce di menu attiva ed
// e' volutamente condivisa fra una sezione e le sue pagine figlie. Il risultato
// era che tutte le 66 pagine di record dichiaravano `/fonti/` come canonical e
// tutti i 17 atti dichiaravano `/evoluzione-storica/`: le pagine di dettaglio
// si auto-deindicizzavano a favore della sezione madre.
//
// L'identita' del documento e' ora derivata esclusivamente da `Astro.url.pathname`,
// cioe' dalla rotta effettivamente generata. `activePath` continua a governare
// SOLO l'evidenziazione del menu e non ha piu' alcun effetto sui metadati.
//
// Politica trailing slash: `astro.config.mjs` usa `build.format: "directory"`,
// quindi ogni rotta e' una directory e ogni URL canonico termina con "/"
// (la home resta "/"). Il dominio canonico resta quello configurato in
// PUBLIC_SITE_URL / SITE_URL: qui non viene reintrodotto alcun dominio.
function toCanonicalPath(pathname: string): string {
  const withoutIndex = pathname.replace(/\/index\.html?$/i, "/");
  const trimmed = withoutIndex.replace(/\/+$/, "");
  return trimmed === "" ? "/" : `${trimmed}/`;
}
const canonicalPath = toCanonicalPath(Astro.url.pathname);
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();

// v0.2.0 — NAVIGAZIONE A GRUPPI.
//
// Con 155 rotte una barra piatta non e' piu' leggibile: le voci vengono
// raggruppate per natura documentaria, non per frequenza d'uso.
//
//   Carriera in corso  -> Palio 16 agosto 2026
//   Documenti di lunga durata -> Regolamento per il Palio, Bando di Violante
//   Corpus storico -> Disciplina vigente, Evoluzione storica
//   Atti della Carriera -> Ordinanze e atti
//   Apparato -> Fonti, Progetto, Ricerca
//
// `activePath` continua a governare SOLO l'evidenziazione: non influisce sul
// canonical (cfr. nota v0.1.0 sopra). Un gruppo e' evidenziato quando una
// qualsiasi delle sue voci corrisponde ad `activePath`.
type NavLink = { href: string; label: string };
type NavEntry = NavLink | { label: string; children: NavLink[] };

const navEntries: NavEntry[] = [
  { href: "/palio-16-agosto-2026", label: "Palio 16 agosto 2026" },
  {
    label: "Documenti fondamentali",
    children: [
      { href: "/documenti-fondamentali", label: "Panoramica" },
      { href: "/regolamento-per-il-palio", label: "Regolamento per il Palio" },
      { href: "/documenti-fondamentali/bando-di-violante", label: "Bando di Violante" },
    ],
  },
  {
    label: "Protocollo Equino",
    children: [
      { href: "/disciplina-vigente", label: "Disciplina vigente" },
      { href: "/evoluzione-storica", label: "Evoluzione storica" },
    ],
  },
  { href: "/ordinanze-e-atti", label: "Ordinanze e atti" },
  { href: "/fonti", label: "Fonti" },
  {
    label: "Progetto",
    children: [
      { href: "/chi-siamo", label: "Il progetto" },
      { href: "/metodologia", label: "Metodologia" },
      { href: "/changelog", label: "Changelog" },
    ],
  },
  { href: "/ricerca", label: "Ricerca" },
];

function isGroup(entry: NavEntry): entry is { label: string; children: NavLink[] } {
  return "children" in entry;
}
/**
 * Rotta pubblica con barra finale. Il sito e' generato con
 * `build.format: "directory"`: la forma canonica di ogni rotta termina con `/`
 * e i collegamenti interni devono usarla, per non far dipendere la
 * navigazione da un redirect dell'hosting.
 */
function rotta(href: string): string {
  return href === "/" || href.endsWith("/") ? href : `${href}/`;
}

function slugify(label: string): string {
  return label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="data:," />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />
    {!indexable && <meta data-pagefind-ignore="all" />}
    <!-- Font self-hosted via @fontsource: nessuna richiesta di rete esterna a servizi Google -->
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>
    <p class="disclaimer-banner" data-pagefind-ignore>
      Progetto documentale indipendente, non ufficiale e ad accesso pubblico. Non affiliato al Comune di Siena —
      <a href="/disclaimer/">leggi il disclaimer completo</a>.
    </p>
    <header class="site-header" data-pagefind-ignore>
      <div class="wrap site-header__inner">
        <a href="/" class="brand">font<span class="wordmark__i">i</span>delpal<span class="wordmark__i">i</span>o<span class="dot">.</span>org</a>
        <a href="/ricerca/" class="nav-search-link" aria-label="Cerca nel sito">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>
        <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-navigation" aria-label="Apri il menu">
          <span class="nav-toggle__icon" aria-hidden="true"></span>
        </button>
        <nav aria-label="Navigazione principale">
          <ul class="main-nav" id="primary-navigation">
            {navEntries.map((entry) =>
              isGroup(entry) ? (
                <li class="nav-group" data-nav-group>
                  <button
                    type="button"
                    class="nav-group__toggle"
                    id={`nav-toggle-${slugify(entry.label)}`}
                    aria-expanded="false"
                    aria-controls={`nav-panel-${slugify(entry.label)}`}
                    data-nav-current={entry.children.some((c) => c.href === activePath) ? "true" : undefined}
                  >
                    {entry.label}
                    <span class="nav-group__chevron" aria-hidden="true"></span>
                  </button>
                  <ul class="nav-group__panel" id={`nav-panel-${slugify(entry.label)}`}>
                    {entry.children.map((child) => (
                      <li>
                        <a href={rotta(child.href)} aria-current={activePath === child.href ? "page" : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={rotta(entry.href)} aria-current={activePath === entry.href ? "page" : undefined}>
                    {entry.label}
                  </a>
                </li>
              )
            )}
          </ul>
        </nav>
      </div>
      <div class="nav-backdrop" id="nav-backdrop" hidden></div>
    </header>
    <main id="contenuto" data-pagefind-body={indexable && searchable ? "" : undefined}>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        <div class="grid">
          <div class="col-6">
            <p class="wordmark wordmark--footer">font<span class="wordmark__i">i</span>delpal<span class="wordmark__i">i</span>o<span class="dot">.</span>org</p>
            <p class="text-caption" style="color: var(--color-text-muted); max-width: 34ch; margin-top: var(--space-1);">
              Osservatorio paliesco indipendente. Prima gli atti. Poi le risposte.
            </p>
            <p class="text-caption footer-contact">
              Segnalazioni e correzioni: <a href="mailto:info@pistakkio.net">info@pistakkio.net</a>
            </p>
          </div>
          <div class="col-6">
            <nav aria-label="Navigazione footer">
              <ul class="main-nav" style="flex-wrap: wrap;">
                <li><a href="/disclaimer/">Disclaimer</a></li>
                <li><a href="/privacy/">Privacy</a></li>
                <li><a href="/metodologia/">Metodologia</a></li>
                <li><a href="/chi-siamo/">Progetto</a></li>
              </ul>
            </nav>
          </div>
        </div>
        <p class="footer-signature">
          Fonti del Palio — un progetto non-profit di Fabrizio Gabrielli.
        </p>
        <p class="footer-credit">
          Made with Love 💚 by <a href={PISTAKKIO_URL} rel="noopener noreferrer" target="_blank">{PISTAKKIO_LABEL}</a>
          {GITHUB_URL && (
            <>
              {" · "}
              <a href={GITHUB_URL} rel="noopener noreferrer" target="_blank">{GITHUB_LABEL}</a>
            </>
          )}
        </p>
      </div>
    </footer>
    <script is:inline>
      // v0.2.1 — Navigazione ibrida: barra compatta (logo + ricerca + hamburger
      // + drawer da destra) sotto 72rem, menu orizzontale invariato da 72rem.
      //
      // Senza JavaScript i pannelli restano visibili come sottoelenchi annidati
      // e tutte le voci sono raggiungibili: lo script assume il controllo solo
      // dopo aver trovato ogni elemento richiesto, collegato gli event listener
      // e inizializzato correttamente lo stato (progressive enhancement).
      //
      // Nota: `.main-nav` e' usato sia nell'header sia nel footer. La barra
      // primaria e' individuata tramite l'id univoco `primary-navigation`
      // (referenziato anche da `aria-controls` dell'hamburger), mai tramite
      // un semplice `querySelector(".main-nav")`.
      (function () {
        var nav = document.getElementById("primary-navigation");
        var header = document.querySelector(".site-header");
        var toggle = document.getElementById("nav-toggle");
        var backdrop = document.getElementById("nav-backdrop");
        if (!nav || !header || !toggle || !backdrop) return;
        var groups = Array.prototype.slice.call(nav.querySelectorAll("[data-nav-group]"));
        if (!groups.length) return;

        var navList = nav; // riferimento all'elemento ul#primary-navigation
        navList.classList.add("main-nav--js");
        header.classList.add("site-header--js");

        var wide = window.matchMedia("(min-width: 72rem)");
        var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        var drawerOpen = false;
        var scrollY = 0;
        var lastFocused = null;

        function panelOf(g) { return g.querySelector(".nav-group__panel"); }
        function toggleOf(g) { return g.querySelector(".nav-group__toggle"); }

        function setGroupOpen(g, open) {
          var panel = panelOf(g);
          var t = toggleOf(g);
          if (!panel || !t) return;
          panel.hidden = !open;
          t.setAttribute("aria-expanded", open ? "true" : "false");
        }
        function closeAllGroups(except) {
          groups.forEach(function (g) { if (g !== except) setGroupOpen(g, false); });
        }

        // ------------------------------------------------------------------
        // Posizione reale del fondo dell'header (il disclaimer puo' essere
        // ancora visibile sopra: non si assume mai top: 0).
        // ------------------------------------------------------------------
        function updateHeaderOffset() {
          var rect = header.getBoundingClientRect();
          var bottom = Math.max(rect.bottom, 0);
          document.documentElement.style.setProperty("--nav-drawer-top", bottom + "px");
        }

        // ------------------------------------------------------------------
        // Blocco/ripristino scroll pagina.
        // ------------------------------------------------------------------
        function lockScroll() {
          scrollY = window.scrollY || window.pageYOffset || 0;
          document.body.style.position = "fixed";
          document.body.style.top = (-scrollY) + "px";
          document.body.style.left = "0";
          document.body.style.right = "0";
          document.body.style.width = "100%";
          document.body.classList.add("nav-scroll-locked");
        }
        function unlockScroll() {
          var wasLocked = document.body.classList.contains("nav-scroll-locked");
          document.body.classList.remove("nav-scroll-locked");
          document.body.style.position = "";
          document.body.style.top = "";
          document.body.style.left = "";
          document.body.style.right = "";
          document.body.style.width = "";
          if (wasLocked) window.scrollTo(0, scrollY);
        }

        // ------------------------------------------------------------------
        // Focus trap: confina Tab/Shift+Tab fra pulsante di chiusura (l'hamburger
        // stesso, che rimane visibile e cliccabile sopra il drawer) e i controlli
        // interni al drawer.
        // ------------------------------------------------------------------
        function focusableInDrawer() {
          var selector = 'a[href], button:not([disabled])';
          return Array.prototype.slice.call(nav.querySelectorAll(selector)).filter(function (el) {
            return el.offsetParent !== null;
          });
        }
        function trapFocus(event) {
          if (event.key !== "Tab") return;
          var items = focusableInDrawer();
          var boundary = [toggle].concat(items);
          if (!boundary.length) return;
          var first = boundary[0];
          var last = boundary[boundary.length - 1];
          var active = document.activeElement;
          if (event.shiftKey) {
            if (active === first || !nav.contains(active)) {
              if (active !== toggle) {
                event.preventDefault();
                last.focus();
              }
            }
          } else {
            if (active === last) {
              event.preventDefault();
              toggle.focus();
            }
          }
        }

        // ------------------------------------------------------------------
        // Apertura/chiusura drawer (solo in modalita' compatta).
        // ------------------------------------------------------------------
        function setInertState(makeInert) {
          if (wide.matches) return;
          if (makeInert) {
            nav.setAttribute("aria-hidden", "true");
            if ("inert" in nav) nav.inert = true;
          } else {
            nav.removeAttribute("aria-hidden");
            if ("inert" in nav) nav.inert = false;
          }
        }

        function openDrawer() {
          if (drawerOpen || wide.matches) return;
          drawerOpen = true;
          lastFocused = document.activeElement;
          updateHeaderOffset();
          setInertState(false);
          header.classList.add("nav-drawer-open");
          backdrop.hidden = false;
          // forza reflow per garantire la transizione d'ingresso
          void backdrop.offsetWidth;
          backdrop.classList.add("nav-backdrop--visible");
          toggle.setAttribute("aria-expanded", "true");
          toggle.setAttribute("aria-label", "Chiudi il menu");
          lockScroll();
          document.addEventListener("keydown", onDrawerKeydown, true);
          var currentGroup = groups.filter(function (g) {
            return toggleOf(g).hasAttribute("data-nav-current");
          })[0];
          closeAllGroups(currentGroup || null);
          if (currentGroup) setGroupOpen(currentGroup, true);
          var firstLink = nav.querySelector("a, .nav-group__toggle");
          if (firstLink) firstLink.focus();
        }

        function closeDrawer(options) {
          var restoreFocus = !options || options.restoreFocus !== false;
          if (!drawerOpen) {
            // chiamato anche in stato non aperto per garantire pulizia in
            // ogni condizione (resize, breakpoint, init incompleta).
          }
          drawerOpen = false;
          header.classList.remove("nav-drawer-open");
          backdrop.classList.remove("nav-backdrop--visible");
          backdrop.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Apri il menu");
          setInertState(wide.matches ? false : true);
          unlockScroll();
          document.removeEventListener("keydown", onDrawerKeydown, true);
          if (restoreFocus && lastFocused !== toggle) {
            toggle.focus();
          }
        }

        function onDrawerKeydown(event) {
          if (event.key === "Escape") {
            event.preventDefault();
            closeDrawer();
            return;
          }
          trapFocus(event);
        }

        toggle.addEventListener("click", function () {
          if (drawerOpen) closeDrawer();
          else openDrawer();
        });

        backdrop.addEventListener("click", function () {
          closeDrawer();
        });

        nav.addEventListener("click", function (event) {
          if (!wide.matches && drawerOpen) {
            var link = event.target.closest ? event.target.closest("a[href]") : null;
            if (link) closeDrawer({ restoreFocus: false });
          }
        });

        // ------------------------------------------------------------------
        // Gruppi accordion: comportamento condiviso fra modalita' compatta
        // (drawer) e modalita' ampia (dropdown), come nel comportamento
        // desktop preesistente.
        // ------------------------------------------------------------------
        groups.forEach(function (g) {
          var openAtLoad = !wide.matches && toggleOf(g).hasAttribute("data-nav-current");
          setGroupOpen(g, openAtLoad);
          toggleOf(g).addEventListener("click", function () {
            var open = toggleOf(g).getAttribute("aria-expanded") === "true";
            closeAllGroups(g);
            setGroupOpen(g, !open);
          });
          g.addEventListener("keydown", function (event) {
            if (event.key !== "Escape") return;
            if (toggleOf(g).getAttribute("aria-expanded") !== "true") return;
            if (!wide.matches && drawerOpen) return; // Escape gestita a livello di drawer
            setGroupOpen(g, false);
            toggleOf(g).focus();
          });
          g.addEventListener("focusout", function (event) {
            if (wide.matches) {
              if (event.relatedTarget && g.contains(event.relatedTarget)) return;
              setGroupOpen(g, false);
            }
          });
        });

        document.addEventListener("click", function (event) {
          if (!wide.matches) return; // in modalita' compatta la chiusura e' governata dal drawer
          var inside = groups.some(function (g) { return g.contains(event.target); });
          if (!inside) closeAllGroups(null);
        });

        // ------------------------------------------------------------------
        // Cambio di modalita' (compatta <-> ampia).
        // ------------------------------------------------------------------
        function resetToWide() {
          closeDrawer({ restoreFocus: false });
          nav.removeAttribute("aria-hidden");
          if ("inert" in nav) nav.inert = false;
          backdrop.hidden = true;
          backdrop.classList.remove("nav-backdrop--visible");
          header.classList.remove("nav-drawer-open");
          unlockScroll();
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Apri il menu");
          closeAllGroups(null);
        }
        function resetToCompact() {
          drawerOpen = false;
          header.classList.remove("nav-drawer-open");
          backdrop.hidden = true;
          backdrop.classList.remove("nav-backdrop--visible");
          unlockScroll();
          toggle.setAttribute("aria-expanded", "false");
          toggle.setAttribute("aria-label", "Apri il menu");
          setInertState(true);
          closeAllGroups(null);
        }

        function handleModeChange(e) {
          if (e.matches) resetToWide();
          else resetToCompact();
        }
        if (typeof wide.addEventListener === "function") {
          wide.addEventListener("change", handleModeChange);
        } else if (typeof wide.addListener === "function") {
          wide.addListener(handleModeChange);
        }

        // Stato iniziale coerente con la modalita' corrente.
        if (wide.matches) {
          setInertState(false);
        } else {
          setInertState(true);
        }

        window.addEventListener("resize", updateHeaderOffset);
        window.addEventListener("orientationchange", updateHeaderOffset);
        updateHeaderOffset();
      })();
    </script>
  </body>
</html>
