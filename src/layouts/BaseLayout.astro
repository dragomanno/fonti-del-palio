---
import "@fontsource/fraunces/500.css";
import "@fontsource/fraunces/600.css";
import "@fontsource/fraunces/700.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "../styles/global.css";
import { SITE_NAME, SITE_URL, PISTAKKIO_URL, PISTAKKIO_LABEL, GITHUB_URL, GITHUB_LABEL } from "../config/site";

export interface Props {
  title: string;
  description?: string;
  activePath?: string;
  /** Se false, esclude la pagina sia dall'indicizzazione dei motori di ricerca
   *  esterni (meta robots noindex) sia dall'indice di ricerca interno Pagefind
   *  (marcatore data-pagefind-ignore="all" nel head). Usato per i documenti di
   *  pianificazione interna, che non sono fonti documentali del Palio.
   *  Pagefind e' integrato: l'indice viene costruito su `dist/` al termine di
   *  `npm run build` e l'esclusione e' quindi effettiva. Default true. */
  indexable?: boolean;
  /** Se false, il contenuto della pagina non viene usato come corpo indicizzato
   *  da Pagefind (utile per pagine di servizio come /ricerca). Default true. */
  searchable?: boolean;
}
const {
  title,
  description = "Fonti del Palio — corpus documentale del Protocollo Equino del Palio di Siena.",
  activePath = "",
  indexable = true,
  searchable = true,
} = Astro.props;
const siteName = SITE_NAME;

// v0.1.0 — IDENTITA' DEL DOCUMENTO E STATO DI NAVIGAZIONE SONO VALORI DISTINTI.
//
// Prima di questa correzione il canonical era derivato da `activePath`, che e'
// una proprieta' di NAVIGAZIONE: serve a evidenziare la voce di menu attiva ed
// e' volutamente condivisa fra una sezione e le sue pagine figlie. Il risultato
// era che tutte le 66 pagine di record dichiaravano `/fonti/` come canonical e
// tutti i 17 atti dichiaravano `/evoluzione-storica/`: le pagine di dettaglio
// si auto-deindicizzavano a favore della sezione madre.
//
// L'identita' del documento e' ora derivata esclusivamente da `Astro.url.pathname`,
// cioe' dalla rotta effettivamente generata. `activePath` continua a governare
// SOLO l'evidenziazione del menu e non ha piu' alcun effetto sui metadati.
//
// Politica trailing slash: `astro.config.mjs` usa `build.format: "directory"`,
// quindi ogni rotta e' una directory e ogni URL canonico termina con "/"
// (la home resta "/"). Il dominio canonico resta quello configurato in
// PUBLIC_SITE_URL / SITE_URL: qui non viene reintrodotto alcun dominio.
function toCanonicalPath(pathname: string): string {
  const withoutIndex = pathname.replace(/\/index\.html?$/i, "/");
  const trimmed = withoutIndex.replace(/\/+$/, "");
  return trimmed === "" ? "/" : `${trimmed}/`;
}
const canonicalPath = toCanonicalPath(Astro.url.pathname);
const canonicalUrl = new URL(canonicalPath, SITE_URL).toString();

// v0.2.0 — NAVIGAZIONE A GRUPPI.
//
// Con 155 rotte una barra piatta non e' piu' leggibile: le voci vengono
// raggruppate per natura documentaria, non per frequenza d'uso.
//
//   Carriera in corso  -> Palio 16 agosto 2026
//   Documenti di lunga durata -> Regolamento per il Palio, Bando di Violante
//   Corpus storico -> Disciplina vigente, Evoluzione storica
//   Atti della Carriera -> Ordinanze e atti
//   Apparato -> Fonti, Progetto, Ricerca
//
// `activePath` continua a governare SOLO l'evidenziazione: non influisce sul
// canonical (cfr. nota v0.1.0 sopra). Un gruppo e' evidenziato quando una
// qualsiasi delle sue voci corrisponde ad `activePath`.
type NavLink = { href: string; label: string };
type NavEntry = NavLink | { label: string; children: NavLink[] };

const navEntries: NavEntry[] = [
  { href: "/palio-16-agosto-2026", label: "Palio 16 agosto 2026" },
  {
    label: "Documenti fondamentali",
    children: [
      { href: "/documenti-fondamentali", label: "Panoramica" },
      { href: "/regolamento-per-il-palio", label: "Regolamento per il Palio" },
      { href: "/documenti-fondamentali/bando-di-violante", label: "Bando di Violante" },
    ],
  },
  {
    label: "Protocollo Equino",
    children: [
      { href: "/disciplina-vigente", label: "Disciplina vigente" },
      { href: "/evoluzione-storica", label: "Evoluzione storica" },
    ],
  },
  { href: "/ordinanze-e-atti", label: "Ordinanze e atti" },
  { href: "/fonti", label: "Fonti" },
  {
    label: "Progetto",
    children: [
      { href: "/chi-siamo", label: "Il progetto" },
      { href: "/metodologia", label: "Metodologia" },
    ],
  },
  { href: "/ricerca", label: "Ricerca" },
];

function isGroup(entry: NavEntry): entry is { label: string; children: NavLink[] } {
  return "children" in entry;
}
function slugify(label: string): string {
  return label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="data:," />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} — ${siteName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — ${siteName}`} />
    <meta name="twitter:description" content={description} />
    {!indexable && <meta data-pagefind-ignore="all" />}
    <!-- Font self-hosted via @fontsource: nessuna richiesta di rete esterna a servizi Google -->
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Salta al contenuto</a>
    <p class="disclaimer-banner" data-pagefind-ignore>
      Progetto documentale indipendente, non ufficiale e ad accesso pubblico. Non affiliato al Comune di Siena —
      <a href="/disclaimer">leggi il disclaimer completo</a>.
    </p>
    <header class="site-header" data-pagefind-ignore>
      <div class="wrap site-header__inner">
        <a href="/" class="brand">font<span class="wordmark__i">i</span>delpal<span class="wordmark__i">i</span>o<span class="dot">.</span>org</a>
        <nav aria-label="Navigazione principale">
          <ul class="main-nav">
            {navEntries.map((entry) =>
              isGroup(entry) ? (
                <li class="nav-group" data-nav-group>
                  <button
                    type="button"
                    class="nav-group__toggle"
                    id={`nav-toggle-${slugify(entry.label)}`}
                    aria-expanded="false"
                    aria-controls={`nav-panel-${slugify(entry.label)}`}
                    data-nav-current={entry.children.some((c) => c.href === activePath) ? "true" : undefined}
                  >
                    {entry.label}
                    <span class="nav-group__chevron" aria-hidden="true"></span>
                  </button>
                  <ul class="nav-group__panel" id={`nav-panel-${slugify(entry.label)}`}>
                    {entry.children.map((child) => (
                      <li>
                        <a href={child.href} aria-current={activePath === child.href ? "page" : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              ) : (
                <li>
                  <a href={entry.href} aria-current={activePath === entry.href ? "page" : undefined}>
                    {entry.label}
                  </a>
                </li>
              )
            )}
          </ul>
        </nav>
      </div>
    </header>
    <main id="contenuto" data-pagefind-body={indexable && searchable ? "" : undefined}>
      <slot />
    </main>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        <div class="grid">
          <div class="col-6">
            <p class="wordmark wordmark--footer">font<span class="wordmark__i">i</span>delpal<span class="wordmark__i">i</span>o<span class="dot">.</span>org</p>
            <p class="text-caption" style="color: var(--color-text-muted); max-width: 34ch; margin-top: var(--space-1);">
              Ricerca documentale del Protocollo Equino. Prima gli atti. Poi le risposte.
            </p>
            <p class="text-caption footer-contact">
              Segnalazioni e correzioni: <a href="mailto:info@pistakkio.net">info@pistakkio.net</a>
            </p>
          </div>
          <div class="col-6">
            <nav aria-label="Navigazione footer">
              <ul class="main-nav" style="flex-wrap: wrap;">
                <li><a href="/disclaimer">Disclaimer</a></li>
                <li><a href="/privacy">Privacy</a></li>
                <li><a href="/metodologia">Metodologia</a></li>
                <li><a href="/chi-siamo">Progetto</a></li>
              </ul>
            </nav>
          </div>
        </div>
        <p class="footer-signature">
          Fonti del Palio — un progetto non-profit di Fabrizio Gabrielli.
        </p>
        <p class="footer-credit">
          Made with Love 💚 by <a href={PISTAKKIO_URL} rel="noopener noreferrer" target="_blank">{PISTAKKIO_LABEL}</a>
          {GITHUB_URL && (
            <>
              {" · "}
              <a href={GITHUB_URL} rel="noopener noreferrer" target="_blank">{GITHUB_LABEL}</a>
            </>
          )}
        </p>
      </div>
    </footer>
    <script is:inline>
      // v0.2.0 — Menu a divulgazione progressiva.
      //
      // Senza JavaScript i pannelli restano visibili come sottoelenchi annidati:
      // ogni voce resta raggiungibile. Lo script assume il controllo solo dopo
      // aver marcato la barra con `main-nav--js`, che e' anche la condizione CSS
      // per il posizionamento sovrapposto su desktop.
      //
      // Comportamento richiesto: apertura al clic e da tastiera (elemento
      // <button> nativo), chiusura con Escape e ripristino del fuoco sul
      // pulsante, chiusura al clic esterno e alla perdita di fuoco. Nessuna
      // apertura al passaggio del mouse. Su desktop tutti i gruppi partono
      // chiusi; sul menu impilato mobile il gruppo della sezione corrente parte
      // aperto, come divulgazione progressiva utile.
      (function () {
        var bar = document.querySelector(".main-nav");
        if (!bar) return;
        var groups = Array.prototype.slice.call(document.querySelectorAll("[data-nav-group]"));
        if (!groups.length) return;
        bar.classList.add("main-nav--js");

        function panelOf(g) { return g.querySelector(".nav-group__panel"); }
        function toggleOf(g) { return g.querySelector(".nav-group__toggle"); }

        function setOpen(g, open) {
          var panel = panelOf(g);
          var toggle = toggleOf(g);
          if (!panel || !toggle) return;
          panel.hidden = !open;
          toggle.setAttribute("aria-expanded", open ? "true" : "false");
        }
        function closeAll(except) {
          groups.forEach(function (g) { if (g !== except) setOpen(g, false); });
        }

        var stacked = window.matchMedia("(max-width: 47.99rem)");
        groups.forEach(function (g) {
          var openAtLoad = stacked.matches && toggleOf(g).hasAttribute("data-nav-current");
          setOpen(g, openAtLoad);
          toggleOf(g).addEventListener("click", function () {
            var open = toggleOf(g).getAttribute("aria-expanded") === "true";
            closeAll(g);
            setOpen(g, !open);
          });
          g.addEventListener("keydown", function (event) {
            if (event.key !== "Escape") return;
            if (toggleOf(g).getAttribute("aria-expanded") !== "true") return;
            setOpen(g, false);
            toggleOf(g).focus();
          });
          g.addEventListener("focusout", function (event) {
            if (event.relatedTarget && g.contains(event.relatedTarget)) return;
            setOpen(g, false);
          });
        });

        document.addEventListener("click", function (event) {
          var inside = groups.some(function (g) { return g.contains(event.target); });
          if (!inside) closeAll(null);
        });
      })();
    </script>
  </body>
</html>
