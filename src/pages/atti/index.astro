---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listActs } from "../../lib/corpus";

const acts = listActs();
const totalArticles = acts.reduce((n, a) => n + a.articleCount, 0);
const totalChunks = acts.reduce((n, a) => n + a.chunkCount, 0);
---

<BaseLayout
  title="Atti del corpus storico"
  description="Tutti gli atti del Protocollo Equino del Palio di Siena censiti nel corpus storico, dal 2012 al 2026, con il numero di articoli e lo stato della provenienza."
  activePath="/evoluzione-storica"
>
  <section class="section" style="padding-block: var(--space-8) var(--space-4);">
    <div class="wrap">
      <nav class="crumbs" aria-label="Percorso" data-pagefind-ignore>
        <a href="/evoluzione-storica/">Evoluzione storica</a>
        <span aria-hidden="true">/</span>
        <span>Atti</span>
      </nav>
      <h1 style="font-family: var(--font-display); font-size: var(--text-title); max-width: 22ch; margin: var(--space-1) 0 0;">
        Gli atti, dal primo all'ultimo.
      </h1>
      <p class="text-muted" style="max-width: var(--measure); margin-top: var(--space-2);">
        L'elenco completo degli atti ricostruiti nel corpus storico. Ogni atto ha un permalink
        stabile e riproduce il proprio testo articolo per articolo, con la fonte canonica in chiaro.
      </p>
      <p class="text-caption" style="margin-top: var(--space-2);">
        {acts.length} atti · {totalArticles} articoli · {totalChunks} unità documentali
      </p>
    </div>
  </section>

  <section class="section" style="padding-block: 0 var(--space-12);">
    <div class="wrap">
      <div class="doc-table-wrap">
        <table
          class="doc-table doc-table--reflow doc-table--sticky acts"
          role="table"
          aria-label="Atti del corpus storico"
        >
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col">Atto</th>
              <th scope="col">Anno</th>
              <th scope="col">Titolo</th>
              <th scope="col">Articoli</th>
              <th scope="col">Provenienza</th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {
              acts.map((a) => (
                <tr role="row">
                  <th scope="row" role="rowheader" data-label="Atto">
                    <a href={`/atti/${a.slug}/`}>{a.registerId}</a>
                  </th>
                  <td role="cell" class="num" data-label="Anno">{a.year}</td>
                  <td role="cell" class="acts__title" data-label="Titolo">{a.title}</td>
                  <td role="cell" class="num" data-label="Articoli">{a.articleCount || "—"}</td>
                  <td role="cell" data-label="Provenienza">
                    {a.provisional ? (
                      <span class="prov">in parte provvisoria</span>
                    ) : (
                      <span class="ok">corrispondenza esatta</span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--text-caption);
    color: var(--color-text-faint);
    margin-bottom: var(--space-2);
  }
  .crumbs a {
    color: var(--color-green);
  }
  /* Il titolo dell'atto e' la colonna elastica: assorbe lo spazio residuo
     mentre identificativo, anno e conteggio restano compatti. */
  @media (min-width: 48rem) {
    .acts th:first-child { width: 11rem; }
    .acts th:nth-child(2) { width: 5rem; }
    .acts th:nth-child(4) { width: 6rem; }
    .acts th:nth-child(5) { width: 12rem; }
    .acts__title { min-width: 18rem; }
  }
  .prov {
    color: var(--color-warning);
  }
  .ok {
    color: var(--color-text-muted);
  }
</style>
