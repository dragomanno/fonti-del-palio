---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DISCIPLINA_SECTIONS, chunksByScope } from "../../lib/corpus";

const sections = DISCIPLINA_SECTIONS.map((s) => {
  const chunks = chunksByScope(s.scope);
  return {
    ...s,
    chunkCount: chunks.length,
    articleCount: chunks.filter((c) => c.articleNumber !== null).length,
  };
}).filter((s) => s.chunkCount > 0);

const totalChunks = sections.reduce((n, s) => n + s.chunkCount, 0);
const totalArticles = sections.reduce((n, s) => n + s.articleCount, 0);
---

<BaseLayout
  title="Disciplina vigente 2026"
  description="La disciplina consolidata del Protocollo Equino del Palio di Siena per l'annualità 2026, articolo per articolo, con citazione della fonte canonica."
  activePath="/disciplina-vigente"
>
  <section class="section" style="padding-block: var(--space-8) var(--space-4);">
    <div class="wrap">
      <span class="section-number">01 — Disciplina vigente</span>
      <h1 class="text-title" style="font-size: var(--text-title); max-width: 24ch;">
        La disciplina consolidata, articolo per articolo.
      </h1>
      <p class="text-muted" style="max-width: var(--measure); margin-top: var(--space-2);">
        Il testo consolidato in vigore per l'annualità 2026, riprodotto verbatim dal corpus
        canonico. Ogni articolo dichiara la propria fonte — file, intervallo di righe, hash del
        contenuto — e mostra quattro indicatori di stato distinti, mai un'unica etichetta che li
        confonda.
      </p>
      <p class="text-caption" style="margin-top: var(--space-2);">
        {totalArticles} articoli · {totalChunks} unità documentali · {sections.length} parti
      </p>
    </div>
  </section>

  <section class="section" style="padding-block: 0 var(--space-12);">
    <div class="wrap">
      <ul class="section-list">
        {
          sections.map((s) => (
            <li>
              <a href={`/disciplina-vigente/${s.scope}/`} class="section-list__item">
                <span class="section-list__ordinal">
                  {String(s.ordinal).padStart(2, "0")}
                </span>
                <span class="section-list__body">
                  <span class="section-list__title">{s.title}</span>
                  <span class="section-list__summary">{s.summary}</span>
                  <span class="section-list__meta">
                    {s.articleCount > 0
                      ? `${s.articleCount} articoli · ${s.chunkCount} unità documentali`
                      : `${s.chunkCount} unità documentali`}
                  </span>
                </span>
                <span class="section-list__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>

      <aside class="note-block">
        <h2>Come leggere gli indicatori di stato</h2>
        <p>
          Le quattro dimensioni sono indipendenti e non vanno sommate in un giudizio unico. In
          particolare, <strong>la mancata riproduzione di una norma in un atto successivo non
          significa che sia stata abrogata</strong>: significa soltanto che non è stata ritrovata
          in quell'atto. Dove le fonti canoniche non documentano una dimensione, il sito lo dichiara
          esplicitamente invece di inferire un valore.
        </p>
        <p>
          Questo sito non sostituisce gli atti originali. È uno strumento di consultazione e
          ricerca su un corpus documentale ricostruito. <a href="/metodologia">Leggi la metodologia</a>.
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .section-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }
  .section-list__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }
  .section-list__item:hover {
    background: var(--color-green-dim);
  }
  .section-list__ordinal {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-green);
    padding-top: 0.375rem;
    flex: none;
  }
  .section-list__body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1 1 auto;
  }
  .section-list__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }
  .section-list__summary {
    color: var(--color-text-muted);
    max-width: var(--measure);
  }
  .section-list__meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }
  .section-list__arrow {
    flex: none;
    padding-top: 0.375rem;
    color: var(--color-text-faint);
  }
  .note-block {
    margin-top: var(--space-6);
    padding: var(--space-3);
    background: var(--color-surface);
    border-left: 3px solid var(--color-green);
  }
  .note-block h2 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin: 0 0 var(--space-1);
  }
  .note-block p {
    max-width: var(--measure);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-1);
  }
  .note-block p:last-child {
    margin-bottom: 0;
  }
</style>
