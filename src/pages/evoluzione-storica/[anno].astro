---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChunkCard from "../../components/ChunkCard.astro";
import {
  chunksByRoute,
  listMemoryYears,
  listActs,
  type Chunk,
} from "../../lib/corpus";

export function getStaticPaths() {
  const years = listMemoryYears();
  const acts = listActs();
  return years.map((year) => ({
    params: { anno: String(year) },
    props: {
      year,
      chunks: chunksByRoute(`/evoluzione-storica/${year}/`),
      acts: acts.filter((a) => a.year === year),
      years,
    },
  }));
}

interface Props {
  year: number;
  chunks: Chunk[];
  acts: ReturnType<typeof listActs>;
  years: number[];
}

const { year, chunks, acts, years } = Astro.props as Props;

const position = years.indexOf(year);
const prev = position > 0 ? years[position - 1] : null;
const next = position < years.length - 1 ? years[position + 1] : null;
---

<BaseLayout
  title={`Memoria incrementale ${year}`}
  description={`Le annotazioni della memoria incrementale del Protocollo Equino relative all'annualità ${year}, con citazione della fonte canonica.`}
  activePath="/evoluzione-storica"
>
  <section class="section" style="padding-block: var(--space-6) var(--space-3);">
    <div class="wrap">
      <nav class="crumbs" aria-label="Percorso" data-pagefind-ignore>
        <a href="/evoluzione-storica/">Evoluzione storica</a>
        <span aria-hidden="true">/</span>
        <span>{year}</span>
      </nav>
      <span class="section-number">Annualità {year}</span>
      <h1 style="font-family: var(--font-display); font-size: var(--text-title); margin: var(--space-1) 0 0;">
        Memoria incrementale {year}
      </h1>
      <p class="text-muted" style="max-width: var(--measure); margin-top: var(--space-2);">
        Le annotazioni registrate nel corpus per questa annualità: cosa cambia, cosa viene
        confermato e cosa resta da verificare. Ogni voce riporta la propria fonte canonica.
      </p>
      <p class="text-caption" style="margin-top: var(--space-2);">
        {chunks.length} annotazioni
      </p>

      {
        acts.length > 0 && (
          <p class="related">
            Atti di questa annualità:{" "}
            {acts.map((a, i) => (
              <>
                {i > 0 && ", "}
                <a href={`/atti/${a.slug}/`}>{a.registerId}</a>
              </>
            ))}
          </p>
        )
      }
    </div>
  </section>

  <section class="section" style="padding-block: 0 var(--space-8);">
    <div class="wrap">
      <div class="corpus">
        {chunks.map((chunk) => <ChunkCard chunk={chunk} />)}
      </div>

      <nav class="pager" aria-label="Navigazione fra le annualità" data-pagefind-ignore>
        {
          prev ? (
            <a href={`/evoluzione-storica/${prev}/`} class="pager__link">
              <span class="pager__dir">← Annualità precedente</span>
              <span class="pager__title">{prev}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/evoluzione-storica/${next}/`} class="pager__link pager__link--next">
              <span class="pager__dir">Annualità successiva →</span>
              <span class="pager__title">{next}</span>
            </a>
          )
        }
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: var(--text-caption);
    color: var(--color-text-faint);
    margin-bottom: var(--space-2);
  }
  .crumbs a {
    color: var(--color-green-ink);
  }
  .related {
    margin-top: var(--space-2);
    font-size: 0.9375rem;
  }
  .corpus {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-1);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  .pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
    color: inherit;
  }
  .pager__link--next {
    text-align: right;
    margin-left: auto;
  }
  .pager__dir {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-green-ink);
  }
  .pager__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
  }
</style>
