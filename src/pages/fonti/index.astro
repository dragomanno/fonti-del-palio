---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChunkCard from "../../components/ChunkCard.astro";
import {
  chunksByRoute,
  listRegistryRecords,
  displayStatus,
  DIMENSION_LABELS,
  FAMILY_LABELS,
} from "../../lib/corpus";

const intro = chunksByRoute("/fonti/");
const records = listRegistryRecords();

const families = ["PE", "RP", "ATT", "LEG"] as const;

const DIMENSIONS = [
  "documentaryStatus",
  "legalStatus",
  "presenceStatus",
  "researchStatus",
] as const;

/**
 * Il registro mostra in tabella le due dimensioni che orientano la
 * consultazione — dove si trova l'atto e che efficacia ha — e conserva tutte
 * e quattro le dimensioni nella scheda di dettaglio di ogni riga. Nessuna
 * dimensione viene rimossa: cambia solo il livello di lettura.
 */
const TABLE_DIMENSIONS = ["documentaryStatus", "legalStatus"] as const;

const rows = records.map((record) => {
  const status = Object.fromEntries(
    DIMENSIONS.map((key) => [key, displayStatus(record.chunk.status[key] ?? null)]),
  ) as Record<(typeof DIMENSIONS)[number], ReturnType<typeof displayStatus>>;

  // Rilievo tipografico per i record che il registro ha gia' normalizzato su
  // un valore di legenda canonico. E' un rinforzo visivo: ogni stato resta
  // comunque scritto per esteso nella propria cella.
  const consolidated = TABLE_DIMENSIONS.some((key) => status[key]?.kind === "value");

  return { record, status, consolidated };
});

const grouped = families
  .map((family) => ({
    family,
    label: FAMILY_LABELS[family],
    rows: rows.filter((r) => r.record.family === family),
  }))
  .filter((g) => g.rows.length > 0);
---

<BaseLayout
  title="Fonti e registro atti"
  description="Il registro delle fonti del Protocollo Equino del Palio di Siena: atti censiti dal 2012 al 2026, con disponibilità documentale, ruolo giuridico e stato della ricerca dichiarati separatamente."
  activePath="/fonti"
>
  <section class="section" style="padding-block: var(--space-8) var(--space-4);">
    <div class="wrap">
      <span class="section-number">03 — Fonti</span>
      <h1 style="font-family: var(--font-display); font-size: var(--text-title); max-width: 22ch; margin: var(--space-1) 0 0;">
        Il registro degli atti, con le lacune dichiarate.
      </h1>
      <p class="text-muted" style="max-width: var(--measure); margin-top: var(--space-2);">
        {records.length} record censiti fra protocolli, regolamenti, atti attuativi e note di
        ricerca. Dove un atto è stato identificato ma non ancora reperito, il registro lo dice:
        una lacuna documentata vale più di una lacuna nascosta.
      </p>
      <p class="text-caption" style="margin-top: var(--space-2);">
        {records.length} record · {grouped.length} famiglie · 2012–2026
      </p>
    </div>
  </section>

  <section class="section" style="padding-block: 0 var(--space-6);">
    <div class="wrap">
      <p class="legend">
        La tabella riporta l'identificativo, l'anno e le due dimensioni di orientamento. Dove il
        registro non ha ancora ricondotto un campo a una voce di legenda, viene mostrato il
        <strong>testo letterale del campo</strong> invece di una dicitura generica. Tutte e quattro
        le dimensioni, con il campo di provenienza, sono in «Dettagli documentali» su ogni riga.
      </p>

      {
        grouped.map((group) => (
          <div class="family">
            <h2 class="family__title" id={`famiglia-${group.family.toLowerCase()}`}>
              {group.label}
              <span class="family__count">{group.rows.length}</span>
            </h2>
            <div class="doc-table-wrap">
              <table
                class={`doc-table doc-table--reflow doc-table--grouped${group.rows.length >= 12 ? " doc-table--sticky" : ""}`}
                role="table"
                aria-labelledby={`famiglia-${group.family.toLowerCase()}`}
              >
                <thead role="rowgroup">
                  <tr role="row">
                    <th scope="col">Identificativo</th>
                    <th scope="col">Anno</th>
                    <th scope="col">{DIMENSION_LABELS.documentaryStatus}</th>
                    <th scope="col">{DIMENSION_LABELS.legalStatus}</th>
                  </tr>
                </thead>
                {group.rows.map(({ record, status, consolidated }) => (
                  <tbody role="rowgroup" class={consolidated ? "is-notable" : undefined}>
                    <tr role="row" class={consolidated ? "is-notable" : undefined}>
                      <th scope="row" role="rowheader" data-label="Identificativo">
                        <a href={`/fonti/${record.slug}/`}>{record.naturalId}</a>
                      </th>
                      <td role="cell" class="num" data-label="Anno">{record.year ?? "—"}</td>
                      {TABLE_DIMENSIONS.map((key) => (
                        <td role="cell" data-label={DIMENSION_LABELS[key]}>
                          <span class={status[key]?.kind === "reason" ? "doc-status--reason" : undefined}>
                            {status[key]?.text}
                          </span>
                        </td>
                      ))}
                    </tr>
                    <tr role="row" class="detail-row">
                      <td role="cell" colspan="4" class="doc-table__detail">
                        <details class="doc-details">
                          <summary aria-label={`Dettagli documentali di ${record.naturalId}`}>
                            Dettagli documentali
                          </summary>
                          <dl class="doc-details__grid">
                            {DIMENSIONS.map((key) => (
                              <div class={status[key]?.documented ? "is-documented" : undefined}>
                                <dt>{DIMENSION_LABELS[key]}</dt>
                                <dd>
                                  <span class={status[key]?.kind === "reason" ? "doc-status--reason" : undefined}>
                                    {status[key]?.text}
                                  </span>
                                  {status[key]?.kind === "literal" && status[key]?.sourceField && (
                                    <span class="doc-details__prov">
                                      testo letterale del campo «{status[key]?.sourceField}»
                                      {status[key]?.sourceLine ? ` · riga ${status[key]?.sourceLine}` : ""}
                                    </span>
                                  )}
                                </dd>
                              </div>
                            ))}
                          </dl>
                        </details>
                      </td>
                    </tr>
                  </tbody>
                ))}
              </table>
            </div>
          </div>
        ))
      }

      <aside class="note-block">
        <h2>Quattro dimensioni, mai una sola etichetta</h2>
        <p>
          Le quattro dimensioni di ogni record sono indipendenti fra loro: disponibilità
          documentale, efficacia o ruolo storico, presenza nell'annualità successiva e stato della
          ricerca. Un atto può essere reperibile ma superato, oppure ancora rilevante ma non
          riprodotto nell'atto successivo. <strong>La mancata riproduzione di una disposizione in
          un atto successivo non ne dimostra automaticamente l'abrogazione.</strong>
        </p>
      </aside>
    </div>
  </section>

  {
    intro.length > 0 && (
      <section class="section" style="padding-block: 0 var(--space-12);">
        <div class="wrap">
          <h2 style="font-family: var(--font-display); font-size: var(--text-heading); margin: 0 0 var(--space-2);">
            Come è stato costruito il registro
          </h2>
          <div class="corpus">
            {intro.map((chunk) => (
              <ChunkCard chunk={chunk} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .family {
    margin-bottom: var(--space-6);
  }
  .family__title {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    margin: 0 0 var(--space-2);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .family__count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }
  .legend {
    max-width: var(--measure);
    margin: 0 0 var(--space-4);
    padding-left: 0.875rem;
    border-left: 2px solid var(--color-border-strong);
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
  /* Colonne del registro: l'identificativo e l'anno restano compatti, le due
     dimensioni documentarie si dividono lo spazio rimanente. */
  @media (min-width: 48rem) {
    .doc-table th:first-child { width: 14rem; }
    .doc-table th:nth-child(2) { width: 5rem; }
    .doc-table th:nth-child(3),
    .doc-table th:nth-child(4) { width: auto; }
    /* La riga di dettaglio non deve ripetere il filetto d'accento. */
    .detail-row td { border-top: none; }
  }
  .note-block {
    padding: var(--space-3);
    background: var(--color-surface);
    border-left: 3px solid var(--color-green);
  }
  .note-block h2 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin: 0 0 var(--space-1);
  }
  .note-block p {
    max-width: var(--measure);
    color: var(--color-text-muted);
    margin: 0;
  }
  .corpus {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-1);
  }
</style>
