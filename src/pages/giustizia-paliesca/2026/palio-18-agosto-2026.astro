---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NotaDocumentaria from "../../../components/NotaDocumentaria.astro";
import CarrieraGiustizia from "../../../components/giustizia/CarrieraGiustizia.astro";

const FONTI = {
  primoRinvio: "https://www.comune.siena.it/novita/rimandato-il-palio-del-16-agosto-2026",
  secondoRinvio:
    "https://www.comune.siena.it/novita/ancora-maltempo-rimandato-di-nuovo-il-palio-del-16-agosto-2026",
  esito: "https://www.comune.siena.it/index.php/novita/palio-18-agosto-2026-vince-il-nicchio",
};
---

<BaseLayout
  title="Giustizia paliesca: le sanzioni per il Palio del 18 agosto 2026"
  description="Le nove deliberazioni della Giunta comunale di Siena del 24 novembre 2026 sul Palio del 18 agosto 2026: nove sanzioni, con PDF in copia conforme e digest."
  activePath="/giustizia-paliesca/2026"
>
  <CarrieraGiustizia slug="palio-18-agosto-2026">
    <NotaDocumentaria titolo="Data della Carriera: 18 agosto 2026" variante="avvertenza">
      <p>
        La Carriera ordinaria dell'agosto si corre il 16 agosto (<a
          href="/regolamento-per-il-palio/#articolo-1">art. 1 del Regolamento per il Palio</a
        >). Nel 2026 il Comune di Siena ha comunicato il <a
          href={FONTI.primoRinvio}
          rel="nofollow noopener">primo rinvio</a
        > e il <a href={FONTI.secondoRinvio} rel="nofollow noopener">secondo rinvio</a> per maltempo;
        la Carriera <a href={FONTI.esito} rel="nofollow noopener">si è svolta martedì 18 agosto 2026</a
        >. Le deliberazioni indicano la Carriera come «PALIO 18 AGOSTO 2026». Gli atti, gli orari e
        la guida della Carriera sono nella sezione <a href="/palio-16-agosto-2026/">Palio del 18
        agosto 2026</a>.
      </p>
    </NotaDocumentaria>
  </CarrieraGiustizia>
</BaseLayout>
