---
import BaseLayout from "../layouts/BaseLayout.astro";
import { GPT_ASSISTANT_URL } from "../config/site";
import {
  loadIndex,
  listActs,
  listRegistryRecords,
  DISCIPLINA_SECTIONS,
  chunksByScope,
} from "../lib/corpus";
import {
  listAtti,
  listAttiPubblicati,
  listCavalli,
  listMaterie,
  listRegistroFonti,
  getCollazione,
  getGiustizia,
  delibereByCarriera,
} from "../lib/carriera";

// v0.2.0 — La Home dichiara due corpus distinti e non li fonde:
//   - la Carriera dell'agosto 2026 (atti a validita' circoscritta a quella Carriera,
//     prevista per il 16 agosto e corsa il 18 agosto 2026 dopo due rinvii);
//   - il Protocollo Equino 2012-2026 e i documenti di lunga durata.
const atti = listAtti();
const attiPubblicati = listAttiPubblicati();
const cavalli = listCavalli();
const materie = listMaterie();
const registroFonti = listRegistroFonti();
const collazione = getCollazione();

// Giustizia paliesca 2026: ultimo aggiornamento del corpus prima dell'inverno
// paliesco. I conteggi provengono dall'indice generato (KB 15), non dal codice.
const delibere = getGiustizia().delibere.filter((d) => d.data.endsWith("/2026"));
const sanzioni = delibere.filter((d) => d.esito !== "archiviazione").length;
const archiviazioni = delibere.length - sanzioni;
const delibereLuglio = delibereByCarriera("palio-3-luglio-2026");
const delibereAgosto = delibereByCarriera("palio-18-agosto-2026");

const index = loadIndex();
const acts = listActs();
const records = listRegistryRecords();

const disciplinaChunks = DISCIPLINA_SECTIONS.reduce(
  (n, s) => n + chunksByScope(s.scope).length,
  0
);
const articleCount = index.chunks.filter((c) => c.articleNumber !== null).length;
// Record del registro (KB04) la cui ricerca d'archivio risulta esplicitamente
// non ancora conclusa. E' un conteggio di dichiarazioni presenti nelle fonti,
// non una stima: la dimensione "stato della ricerca" di questi record riporta
// notYetEvaluated invece di un valore dedotto.
const pendingResearch = records.filter(
  (r) => r.chunk.status.researchStatus?.reason === "notYetEvaluated"
).length;

const sections = [
  {
    number: "01",
    title: "Giustizia paliesca",
    body: "Le deliberazioni della Giunta comunale sulle sanzioni per le Carriere, anno per anno. Per il 2026, le delibere del 24 novembre sulle Carriere del 3 luglio e del 18 agosto, in copia conforme ripresa dall'Albo Pretorio.",
    meta: `${delibere.length} delibere · ${sanzioni} sanzioni · ${archiviazioni} ${archiviazioni === 1 ? "archiviazione" : "archiviazioni"}`,
    href: "/giustizia-paliesca/",
  },
  {
    number: "02",
    title: "Palio del 18 agosto 2026",
    body: "La Carriera dell'agosto 2026, corsa il 18 agosto dopo due rinvii per maltempo: gli atti che la disciplinano, i cavalli ammessi alle previsite, le materie di accesso e sicurezza e la guida pratica.",
    meta: `${atti.length} atti · ${cavalli.length} cavalli · ${materie.length} materie`,
    href: "/palio-16-agosto-2026/",
  },
  {
    number: "03",
    title: "Ordinanze e atti",
    body: "Le schede dei singoli atti della Carriera, ciascuna con estremi, digest del file acquisito e stato di ripubblicazione dichiarato.",
    meta: `${atti.length} schede · ${attiPubblicati.length} PDF ripubblicati`,
    href: "/ordinanze-e-atti/",
  },
  {
    number: "04",
    title: "Documenti fondamentali",
    body: "I documenti di lunga durata: il Regolamento per il Palio, la sua edizione previgente con la collazione articolo per articolo, il Bando di Violante del 1729.",
    meta: `${registroFonti.length} fonti registrate · ${collazione.prospetto.length} articoli collazionati`,
    href: "/documenti-fondamentali/",
  },
  {
    number: "05",
    title: "Disciplina vigente",
    body: `Il testo consolidato in vigore per il 2026 in ${DISCIPLINA_SECTIONS.length} parti, articolo per articolo, con la fonte canonica sotto ogni unità.`,
    meta: `${disciplinaChunks} unità documentali`,
    href: "/disciplina-vigente/",
  },
  {
    number: "06",
    title: "Evoluzione storica",
    body: "Come il Protocollo è cambiato fra il 2012 e il 2026: gli atti anno per anno e la memoria incrementale che ne registra le variazioni.",
    meta: `${acts.length} atti · 15 annualità`,
    href: "/evoluzione-storica/",
  },
  {
    number: "07",
    title: "Fonti e registro atti",
    body: "Il registro degli atti acquisiti, identificati e ancora da reperire, con quattro dimensioni di stato dichiarate separatamente.",
    meta: `${records.length} record · ${pendingResearch} con ricerca non conclusa`,
    href: "/fonti/",
  },
  {
    number: "08",
    title: "Ricerca nel corpus",
    body: "Cerca fra articoli, atti, schede documentarie e annotazioni. Indice statico servito dal sito stesso: nessuna interrogazione esce da qui.",
    meta: `${index.chunkCount} unità indicizzate`,
    href: "/ricerca/",
  },
];

---
<BaseLayout
  title="Home"
  ogTitle="Fonti del Palio"
  ogDescription="Osservatorio paliesco indipendente. Prima gli atti. Poi le risposte."
  activePath="/"
  description="Fonti del Palio: osservatorio indipendente su Regolamento, Bando di Violante, Protocollo Equino, ordinanze e atti del Palio di Siena."
>
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__lead">
        <span class="section-number">OSSERVATORIO PALIESCO INDIPENDENTE</span>
        <h1 style="font-size: var(--text-hero); max-width: 18ch; margin-bottom: var(--space-3);">
          Prima gli atti.<br />Poi le risposte.
        </h1>
        <p style="font-size: var(--text-body-lg); max-width: 46ch;">
          Non interpretazioni isolate. Fonti collegate. Dai documenti fondamentali —
          Regolamento per il Palio e Bando di Violante — al Protocollo Equino, alle
          ordinanze e agli atti della singola Carriera: un corpus documentario sul Palio
          di Siena, consultabile secondo una gerarchia chiara e nei limiti documentali
          dichiarati.
        </p>
        <p class="text-caption" style="max-width: 52ch;">
          Progetto documentale indipendente, non ufficiale e ad accesso pubblico — non
          affiliato al Comune di Siena. <a href="/disclaimer">Leggi il disclaimer</a>.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/giustizia-paliesca/2026/">Giustizia paliesca 2026</a>
          <a class="btn btn--secondary" href="/palio-16-agosto-2026/">Palio del 18 agosto 2026</a>
          <a class="btn btn--secondary" href="/documenti-fondamentali/">Documenti fondamentali</a>
          <a
            class="btn btn--secondary"
            href={GPT_ASSISTANT_URL}
            rel="noopener noreferrer"
            target="_blank"
          >
            Assistente documentario GPT
            <span class="btn__note">ChatGPT ↗</span>
          </a>
        </div>
      </div>
      <dl class="hero__stats">
        <div><dt>Unità documentali</dt><dd>{index.chunkCount}</dd></div>
        <div><dt>Articoli</dt><dd>{articleCount}</dd></div>
        <div><dt>Atti</dt><dd>{acts.length}</dd></div>
        <div><dt>Record nel registro</dt><dd>{records.length}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section aggiornamento" aria-labelledby="aggiornamento-titolo">
    <div class="wrap aggiornamento__inner">
      <div>
        <span class="section-number">Ultimo aggiornamento del corpus · 25 novembre 2026</span>
        <h2 id="aggiornamento-titolo" class="text-heading" style="font-size: var(--text-heading);">
          Giustizia paliesca 2026: le sanzioni per le due Carriere
        </h2>
        <p class="text-muted" style="max-width: 60ch;">
          Il 24 novembre 2026 la Giunta comunale di Siena ha deliberato sui procedimenti
          disciplinari delle Carriere del 3 luglio e del 18 agosto 2026. Le {delibere.length}
          deliberazioni sono pubblicate come fonti primarie: copia conforme ripresa dall'Albo
          Pretorio, digest di integrità e scheda documentaria per ciascuna, con il testo del
          Regolamento su censura, deplorazione, diffida e ammonizione.
        </p>
        <div class="btn-row">
          <a class="btn btn--secondary" href="/giustizia-paliesca/2026/palio-3-luglio-2026/">Palio del 3 luglio 2026</a>
          <a class="btn btn--secondary" href="/giustizia-paliesca/2026/palio-18-agosto-2026/">Palio del 18 agosto 2026</a>
        </div>
      </div>
      <div class="aggiornamento__aside">
        <dl class="aggiornamento__stats">
          <div><dt>Delibere</dt><dd>{delibere.length}</dd></div>
          <div><dt>Sanzioni</dt><dd>{sanzioni}</dd></div>
          <div><dt>Archiviazioni</dt><dd>{archiviazioni}</dd></div>
          <div><dt>3 luglio · 18 agosto</dt><dd>{delibereLuglio.length} · {delibereAgosto.length}</dd></div>
        </dl>
        <a href="/giustizia-paliesca/" class="aggiornamento__card" data-home-card="giustizia-fascia">
          <div class="card card--accent">
            <span class="section-number">Sezione</span>
            <h3 class="text-heading">Giustizia paliesca</h3>
            <p class="text-muted">
              Le deliberazioni della Giunta comunale sulle sanzioni per le Carriere,
              raccolte anno per anno.
            </p>
            <p class="text-caption aggiornamento__meta">2026 · {delibere.length} delibere</p>
            <span class="link-arrow">Consulta</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="section carriera-strip">
    <div class="wrap">
      <span class="section-number">Carriera dell'agosto 2026</span>
      <h2 class="text-heading" style="font-size: var(--text-heading);">
        Gli atti del Palio del 18 agosto 2026 valgono per quella Carriera
      </h2>
      <p class="text-muted" style="max-width: 62ch;">
        Le ordinanze e gli atti dirigenziali raccolti qui hanno validità circoscritta alla
        Carriera dell'agosto 2026, prevista per il 16 agosto e corsa il 18 agosto dopo due rinvii
        per maltempo: non modificano il Regolamento per il Palio né il Protocollo Equino
        e non si applicano ad altre Carriere. Sono pubblicati con il digest del file acquisito
        e con lo stato di ripubblicazione dichiarato caso per caso.
      </p>
      <div class="btn-row">
        <a class="btn btn--secondary" href="/palio-16-agosto-2026/previsite/">Cavalli ammessi alle previsite</a>
        <a class="btn btn--secondary" href="/palio-16-agosto-2026/accesso-e-sicurezza/">Accesso e sicurezza</a>
        <a class="btn btn--secondary" href="/palio-16-agosto-2026/guida-pratica/">Guida pratica</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid">
        {sections.map((s) => (
          <div class="col-4">
            <a href={s.href} style="text-decoration: none; color: inherit; display: block; height: 100%;">
              <div class="card card--accent" style="height: 100%;">
                <span class="section-number">{s.number}</span>
                <h2 class="text-heading" style="font-size: var(--text-heading);">{s.title}</h2>
                <p class="text-muted" style="margin-bottom: var(--space-1);">{s.body}</p>
                <p class="text-caption" style="margin-bottom: var(--space-2); font-family: var(--font-mono);">{s.meta}</p>
                <span class="link-arrow">Consulta</span>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="border-bottom: none;">
    <div class="wrap">
      <div class="grid">
        <div class="col-8">
          <span class="section-number">Un progetto civico e documentario indipendente</span>
          <p class="text-muted" style="max-width: 56ch;">
            Fonti del Palio è un progetto civico, documentario e indipendente, senza
            scopo di lucro né finalità commerciali, concepito come servizio alla Città
            di Siena e alla comunità interessata allo studio e alla comprensione del
            Palio attraverso le sue fonti documentarie. Non vende servizi, non promuove
            alcuna attività e non è collegato a enti ufficiali del Palio di Siena.
            <a href="/chi-siamo">Scopri il progetto</a>.
          </p>
          <p class="text-muted" style="max-width: 56ch; margin-top: var(--space-2);">
            Fonti del Palio non nasce contro una carenza del Comune, ma intorno a una
            difficoltà reale di consultazione di un patrimonio documentario distribuito
            su più canali ufficiali.
          </p>
          <p class="text-muted" style="max-width: 56ch; margin-top: var(--space-2);">
            Fonti del Palio non persegue la completezza cronachistica della singola
            Carriera. Seleziona e organizza i documenti che hanno valore normativo,
            procedurale, operativo, storico o documentario stabile, con particolare
            attenzione a quelli utili agli addetti ai lavori e alla comprensione
            istituzionale del Palio.
          </p>
          <p class="text-muted" style="max-width: 56ch; margin-top: var(--space-2);">
            Ogni frammento pubblicato dichiara la propria origine: file canonico, intervallo di
            righe e hash del contenuto. La metodologia documentaria e le scelte di ammissione al
            corpus sono definite e supervisionate dal curatore unico del progetto. Dove le fonti
            non dicono qualcosa, il sito lo scrive invece di dedurlo: per {pendingResearch} dei
            {records.length} record del registro la ricerca d'archivio risulta dichiaratamente
            non conclusa, e resta scritto così.
            <a href="/metodologia">Leggi la metodologia</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero editoriale: composizione asimmetrica, nessun blocco decorativo
     sovradimensionato. Le sezioni utili restano raggiungibili subito. */
  .hero {
    padding-block: var(--space-6) var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }
  @media (min-width: 48rem) {
    .hero { padding-block: var(--space-6) var(--space-8); }
  }
  .hero__inner {
    display: grid;
    gap: var(--space-6);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-8);
    }
  }
  .hero__lead p { color: var(--color-text-muted); }

  /* Fascia della Carriera dell'agosto 2026: distingue visivamente gli atti a validita'
     circoscritta dal corpus di lunga durata, senza gerarchizzarli. */
  .carriera-strip {
    background: var(--color-surface);
  }

  /* Ultimo aggiornamento del corpus: resta in evidenza durante l'inverno
     paliesco, finche' il corpus non cambia. Bordo d'accento, nessun badge. */
  .aggiornamento {
    border-left: 3px solid var(--color-green);
  }
  .aggiornamento__inner {
    display: grid;
    gap: var(--space-4);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .aggiornamento__inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-8);
    }
  }
  .aggiornamento__aside {
    display: grid;
    gap: var(--space-3);
    min-width: 0;
  }
  .aggiornamento__card {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .aggiornamento__card .text-heading {
    font-size: var(--text-heading);
  }
  .aggiornamento__card .text-muted {
    margin-bottom: var(--space-1);
  }
  .aggiornamento__meta {
    margin-bottom: var(--space-2);
    font-family: var(--font-mono);
  }
  .aggiornamento__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-3);
    margin: 0;
  }
  .aggiornamento__stats dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-faint);
  }
  .aggiornamento__stats dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-display);
    font-size: 1.75rem;
  }

  /* Cifre del corpus come metadati documentari, non come badge decorativi. */
  .hero__stats {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 60rem) {
    .hero__stats { grid-template-columns: 1fr; }
  }
  .hero__stats > div {
    background: var(--color-surface);
    padding: 0.875rem var(--space-2);
    display: flex;
    flex-direction: column-reverse;
    gap: 0.125rem;
  }
  .hero__stats dt {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    color: var(--color-text-faint);
    line-height: 1.4;
  }
  .hero__stats dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.375rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.2;
    font-variant-numeric: tabular-nums lining-nums;
  }
</style>
