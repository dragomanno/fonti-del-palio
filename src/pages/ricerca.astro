---
/**
 * Ricerca statica sul corpus, servita da Pagefind.
 *
 * L'indice viene costruito da `pagefind --site dist` al termine di
 * `npm run build` e servito come file statici sotto /pagefind/. Non c'è
 * backend, non c'è chiamata di rete verso terze parti, non c'è alcun livello
 * AI: la ricerca funziona in modo identico con AI_ENABLED=false perché non
 * dipende in alcun modo da quel percorso.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadIndex } from "../lib/corpus";

const index = loadIndex();
---

<BaseLayout
  title="Ricerca nel corpus"
  description="Cerca fra gli atti, gli articoli e le annotazioni del corpus documentale del Protocollo Equino del Palio di Siena. Ricerca statica, senza server e senza tracciamento."
  activePath="/ricerca"
  searchable={false}
>
  <section class="section" style="padding-block: var(--space-8) var(--space-3);">
    <div class="wrap">
      <span class="section-number">Ricerca</span>
      <h1 style="font-family: var(--font-display); font-size: var(--text-title); max-width: 20ch; margin: var(--space-1) 0 0;">
        Cerca nel corpus.
      </h1>

      {/* v0.2.0 — Il campo di ricerca precede la spiegazione: chi arriva qui
          vuole cercare, non leggere come funziona l'indice. La nota tecnica
          resta, subito sotto. */}
      <div id="search" class="search-mount"></div>

      <p class="text-muted" style="max-width: var(--measure); margin-top: var(--space-3);">
        La ricerca copre {index.chunkCount} unità documentali del corpus del Protocollo Equino
        e le schede documentarie della Carriera in corso, del Regolamento per il Palio e del
        Bando di Violante. Funziona interamente nel browser su un indice statico: nessuna
        interrogazione lascia questo sito, nessun tracciamento, nessun servizio esterno.
      </p>
    </div>
  </section>

  <section class="section" style="padding-block: 0 var(--space-12);">
    <div class="wrap">
      <noscript>
        <p class="fallback">
          La ricerca richiede JavaScript. Senza JavaScript il corpus resta comunque interamente
          navigabile: parti dalla <a href="/disciplina-vigente/">disciplina vigente</a>, dalla
          <a href="/evoluzione-storica/">cronologia 2012–2026</a> o dal
          <a href="/fonti/">registro delle fonti</a>.
        </p>
      </noscript>

      <p class="fallback" id="search-fallback" hidden>
        L'indice di ricerca non è disponibile in questo ambiente — succede quando il sito gira in
        modalità sviluppo, dove l'indice non viene generato. Nella versione pubblicata la ricerca
        è attiva. Nel frattempo puoi navigare da
        <a href="/disciplina-vigente/">disciplina vigente</a>,
        <a href="/evoluzione-storica/">evoluzione storica</a> o
        <a href="/fonti/">fonti</a>.
      </p>

      <aside class="hints">
        <h2>Cosa puoi cercare</h2>
        <ul>
          <li>Il numero di un articolo del Regolamento, ad esempio <code>articolo 37</code>.</li>
          <li>L'identificativo di un atto, ad esempio <code>PE-2019-01</code>, <code>ATT-2021-ORD-005</code> o <code>ATT-2026-ORD-058</code>.</li>
          <li>Un tema, ad esempio <code>previsite</code>, <code>tratta</code>, <code>farmaci controllati</code>, <code>passeggini</code>.</li>
          <li>Il nome di un cavallo ammesso alle previsite o del suo proprietario.</li>
          <li>Il nome di una Contrada, per la descrizione dei confini nel Bando di Violante.</li>
          <li>Un'annualità, ad esempio <code>2016</code>.</li>
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Pagefind pubblica la propria UI fra gli asset statici generati sopra dist/.
  // In dev quell'indice non esiste: in quel caso mostriamo il fallback
  // navigabile invece di lasciare la pagina muta.
  async function mountSearch() {
    const mount = document.querySelector("#search");
    const fallback = document.querySelector("#search-fallback");
    if (!mount) return;

    const styles = document.createElement("link");
    styles.rel = "stylesheet";
    styles.href = "/pagefind/pagefind-ui.css";
    document.head.appendChild(styles);

    // pagefind-ui.js è uno script classico che espone il costruttore come
    // globale: non è un modulo ES con export nominati. Viene quindi iniettato
    // come <script> e atteso, non importato. Il file esiste solo dopo
    // `pagefind --site dist`, cioè in build e non in dev.
    const loaded = await new Promise<boolean>((resolve) => {
      const tag = document.createElement("script");
      tag.src = "/pagefind/pagefind-ui.js";
      tag.onload = () => resolve(true);
      tag.onerror = () => resolve(false);
      document.head.appendChild(tag);
    });

    const PagefindUI = (window as unknown as { PagefindUI?: new (o: unknown) => unknown })
      .PagefindUI;

    try {
      if (!loaded || typeof PagefindUI !== "function") {
        throw new Error("indice Pagefind non disponibile");
      }
      new PagefindUI({
        element: "#search",
        // v0.2.0 — Parametri di ranking Pagefind. Con i valori predefiniti le
        // schede brevi del registro (poche decine di parole) superavano le
        // pagine istituzionali per sola densita' lessicale: una ricerca di
        // «Regolamento 2019» restituiva prima la scheda di registro della
        // fonte e non la pagina del Regolamento. Si riduce il peso della
        // brevita' della pagina, si alza la saturazione della frequenza dei
        // termini e si privilegia la corrispondenza esatta sulla similarita'
        // approssimata. Nessuna pagina viene esclusa o retrocessa d'autorita'.
        ranking: {
          pageLength: 0.3,
          termFrequency: 1.0,
          termSaturation: 2.0,
          termSimilarity: 9.0,
        },
        showSubResults: true,
        showImages: false,
        pageSize: 10,
        translations: {
          placeholder: "Cerca fra atti, articoli e annotazioni",
          clear_search: "Azzera",
          load_more: "Mostra altri risultati",
          search_label: "Cerca nel corpus documentale",
          filters_label: "Filtri",
          zero_results: "Nessun risultato per [SEARCH_TERM]",
          many_results: "[COUNT] risultati per [SEARCH_TERM]",
          one_result: "Un risultato per [SEARCH_TERM]",
          alt_search:
            "Nessun risultato per [SEARCH_TERM]. Risultati per [DIFFERENT_TERM]",
          search_suggestion:
            "Nessun risultato per [SEARCH_TERM]. Prova con una di queste ricerche:",
          searching: "Ricerca di [SEARCH_TERM]…",
        },
      });
    } catch {
      if (fallback instanceof HTMLElement) fallback.hidden = false;
    }
  }
  mountSearch();
</script>

<style>
  .search-mount {
    margin-bottom: var(--space-4);
    --pagefind-ui-primary: var(--color-green);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-border-strong);
    --pagefind-ui-tag: var(--color-surface-2);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-font: var(--font-body);
  }
  /* Il widget di ricerca deve leggersi come uno strumento documentario e non
     come un prodotto di chat: campo rettangolare a raggio contenuto,
     evidenziazioni tonali al posto del giallo predefinito, separazione dei
     risultati con filetti sottili. */
  .search-mount :global(.pagefind-ui__form::before) {
    opacity: 0.55;
  }
  .search-mount :global(.pagefind-ui__search-input),
  .search-mount :global(.pagefind-ui__search-clear) {
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }
  .search-mount :global(.pagefind-ui__search-input:focus) {
    border-color: var(--color-green);
  }
  .search-mount :global(.pagefind-ui__search-input::placeholder) {
    color: var(--color-text-faint);
  }
  .search-mount :global(.pagefind-ui__result) {
    border-top: 1px solid var(--color-border);
  }
  .search-mount :global(.pagefind-ui__result-title) {
    font-family: var(--font-display);
  }
  .search-mount :global(.pagefind-ui__result-link) {
    color: var(--color-text);
  }
  .search-mount :global(.pagefind-ui__result-link:hover) {
    color: var(--color-green);
  }
  .search-mount :global(.pagefind-ui__result-excerpt) {
    color: var(--color-text-muted);
  }
  .search-mount :global(mark) {
    background: rgba(184, 220, 22, 0.22);
    color: var(--color-text);
    padding: 0 0.1em;
    border-radius: 2px;
  }
  .search-mount :global(.pagefind-ui__message) {
    color: var(--color-text-muted);
    font-size: var(--text-caption);
  }
  .search-mount :global(.pagefind-ui__button) {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }
  .search-mount :global(.pagefind-ui__button:hover) {
    border-color: var(--color-green);
    background: var(--color-green-dim);
  }
  .fallback {
    max-width: var(--measure);
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-warning);
    background: var(--color-surface);
    color: var(--color-text-muted);
  }
  .hints {
    margin-top: var(--space-4);
    padding: var(--space-3);
    background: var(--color-surface);
    border-left: 3px solid var(--color-green);
    max-width: var(--measure);
  }
  .hints h2 {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin: 0 0 var(--space-1);
  }
  .hints ul {
    margin: 0;
    padding-left: 1.125rem;
    color: var(--color-text-muted);
  }
  .hints li {
    margin-bottom: 0.375rem;
  }
  .hints code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--color-surface-2);
    padding: 0.0625rem 0.25rem;
  }
</style>
